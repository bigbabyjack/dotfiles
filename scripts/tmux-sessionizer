#!/usr/bin/env bash

# tmux-sessionizer - Fuzzy find and switch to project directories
# Based on ThePrimeagen's tmux-sessionizer

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Project roots: scan one level deep so each subdir is a candidate session
    project_roots=(
        ~/workspace
        ~/code
    )

    selected=$( {
        find "${project_roots[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
        printf '%s\n' "$HOME/dotfiles" "$HOME/.config"
    } | sort -u | fzf --reverse --border --prompt="Project: " --height=60%)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

# If not in tmux and tmux is not running, start new session
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

# If session doesn't exist, create it detached
if ! tmux has-session -t="$selected_name" 2> /dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

# Switch to the session
if [[ -z $TMUX ]]; then
    tmux attach-session -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
